<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ if url !== "/" }}{{ title }} · {{ /if }}clojure-pds documentation</title>
{{ if description }}<meta name="description" content="{{ description }}">{{ /if }}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/assets/style.css">
<script>
  // Applied before first paint so the page never flashes the wrong theme.
  // Dark by default; an explicit choice from the toggle wins.
  let theme = "dark";
  try {
    const stored = localStorage.getItem("clojure-pds-theme");
    if (stored === "light" || stored === "dark") theme = stored;
  } catch (_) { /* private mode */ }
  document.documentElement.dataset.theme = theme;
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
  <button class="icon-button nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>

  <a class="brand" href="/">
    <img src="/assets/logo.svg" width="32" height="32" alt="">
    <span class="brand-name">clojure-pds</span>
    <span class="brand-tag">docs</span>
  </a>

  <button class="search-trigger" type="button" aria-label="Search the documentation">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <span>Search docs</span>
    <kbd>/</kbd>
  </button>

  <div class="topbar-actions">
    <button class="icon-button theme-toggle" type="button" aria-label="Switch colour theme">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
    </button>
    <a class="icon-button" href="{{ repo }}" target="_blank" rel="noopener noreferrer" aria-label="clojure-pds on GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-filled"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" fill="currentColor"/></svg>
    </a>
  </div>
</header>

<div class="shell">
  <nav class="sidebar" aria-label="Documentation">
    <div class="sidebar-inner">
      {{ for section of sidebar }}
      <section class="nav-section">
        <h2 class="nav-title">{{ section.title }}</h2>
        <ul>
          {{ for item of section.items }}
          <li>
            <a href="{{ item.url }}"{{ if item.url === url }} aria-current="page"{{ /if }}>{{ item.label }}</a>
          </li>
          {{ /for }}
        </ul>
      </section>
      {{ /for }}
    </div>
  </nav>
  <div class="sidebar-scrim" hidden></div>

  <main id="main">
    {{ content }}
  </main>
</div>

<dialog class="search-dialog" aria-label="Search documentation">
  <form method="dialog" class="search-head">
    <svg viewBox="0 0 24 24" aria-hidden="true" class="search-icon"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="search" class="search-input" placeholder="Search the documentation…" autocomplete="off" aria-label="Search query">
    <button class="search-close" value="close" aria-label="Close search">Esc</button>
  </form>
  <div class="search-results" role="listbox" aria-label="Search results"></div>
  <p class="search-empty">Type to search across every page.</p>
</dialog>

<script src="/assets/docs.js" type="module"></script>
</body>
</html>
