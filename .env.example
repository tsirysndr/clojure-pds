# Reference only: the Clojure server does not automatically load this file.
PDS_HOST=127.0.0.1
PDS_PORT=3000
PDS_HOSTNAME=localhost
PDS_PUBLIC_URL=http://localhost:3000
PDS_USER_DOMAIN=pds.localhost
PDS_ENABLE_SIGNUP=false
PDS_REQUIRE_INVITE_CODE=false
PDS_FIREHOSE_MAX_CLIENTS=64
PDS_FIREHOSE_BACKFILL_SECONDS=86400
PDS_FIREHOSE_MAX_BACKLOG=1000
# Leave unset to disable administrative endpoints. Basic username is admin.
# PDS_ADMIN_PASSWORD=replace-with-a-long-random-secret
# Generate once and save securely: 32 random bytes, base64url encoded.
PDS_MASTER_KEY=
PDS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/clojure_pds
PDS_DATABASE_USER=pds
PDS_DATABASE_PASSWORD=
# PostgreSQL remains the default blob backend. S3 stores bytes externally while
# PostgreSQL retains ownership, MIME type, size, and the object locator.
PDS_BLOB_BACKEND=postgres
# Optional shared rate limits. No Redis connection is made in memory mode.
PDS_RATE_LIMIT_BACKEND=memory
PDS_RATE_LIMIT_REQUESTS=120
PDS_RATE_LIMIT_WINDOW_SECONDS=60
# PDS_REDIS_URL=rediss://user:password@redis.example.com:6379/0
# PDS_REDIS_PREFIX=clojure-pds
# PDS_S3_BUCKET=pds-blobs
# PDS_S3_REGION=us-east-1
# PDS_S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
# PDS_S3_FORCE_PATH_STYLE=false
# PDS_S3_PREFIX=blobs
# Omit credentials to use the AWS default credential chain.
# PDS_S3_ACCESS_KEY_ID=
# PDS_S3_SECRET_ACCESS_KEY=
# PDS_S3_SESSION_TOKEN=
# Leave ALL three UNSET to disable email; do not export blank values.
# PDS_EMAIL_WORKER_URL=https://your-worker.example.workers.dev/
# PDS_EMAIL_WORKER_TOKEN=
# PDS_EMAIL_FROM=noreply@example.com
