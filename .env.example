# Reference only: the Clojure server does not automatically load this file.
PDS_HOST=127.0.0.1
PDS_PORT=3000
PDS_HOSTNAME=localhost
PDS_PUBLIC_URL=http://localhost:3000
PDS_USER_DOMAIN=pds.localhost
PDS_PLC_URL=https://plc.directory
# Public identity endpoints only. Set TTL to 0 to disable caching.
PDS_IDENTITY_CACHE_TTL_SECONDS=300
PDS_IDENTITY_CACHE_MAX_ENTRIES=1024
# Use plc for portable identities; web remains the default for local development.
# PLC requires HTTPS public URL and a non-reserved user domain.
PDS_DID_METHOD=web
PDS_ENABLE_SIGNUP=false
PDS_REQUIRE_INVITE_CODE=false
PDS_FIREHOSE_MAX_CLIENTS=64
PDS_FIREHOSE_BACKFILL_SECONDS=86400
PDS_FIREHOSE_MAX_BACKLOG=1000
# Opt-in relay discovery; public PDS URL must use HTTPS on port 443.
# PDS_RELAY_URLS=https://relay.example.com,https://other-relay.example.com
# PDS_RELAY_INTERVAL_SECONDS=1200
# Optional proxy defaults; explicit atproto-proxy headers work without these.
# PDS_APPVIEW_SERVICE=did:web:appview.example.com#bsky_appview
# PDS_LABELER_SERVICE=did:web:labeler.example.com#atproto_labeler
# Slots cover preparation and response delivery. Temporary payload budget:
# PDS_PROXY_MAX_CONCURRENT * (PDS_PROXY_MAX_REQUEST_BYTES +
# PDS_PROXY_MAX_RESPONSE_BYTES), 240 MiB by default, staged on disk.
PDS_PROXY_MAX_CONCURRENT=16
PDS_PROXY_MAX_REQUEST_BYTES=5242880
PDS_PROXY_MAX_RESPONSE_BYTES=10485760
PDS_PROXY_TIMEOUT_MS=10000
# Per-account proxy budget, shared across instances with the Redis backend.
PDS_PROXY_ACCOUNT_RATE_LIMIT_ENABLED=true
PDS_PROXY_ACCOUNT_RATE_LIMIT_REQUESTS=600
PDS_PROXY_ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=300
# Leave unset to disable administrative endpoints. Basic username is admin.
# PDS_ADMIN_PASSWORD=replace-with-a-long-random-secret
# Generate once and save securely: 32 random bytes, base64url encoded.
PDS_MASTER_KEY=
# Leave all three PDS_DATABASE_* variables unset to use the zero-configuration
# SQLite fallback at PDS_SQLITE_PATH (default data/clojure-pds.sqlite3).
PDS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/clojure_pds
PDS_DATABASE_USER=pds
PDS_DATABASE_PASSWORD=
# Shared by HTTP handlers and background workers in each server process.
PDS_DB_POOL_SIZE=20
PDS_DB_POOL_TIMEOUT_MS=5000
# PostgreSQL remains the default blob backend. S3 stores bytes externally while
# PostgreSQL retains ownership, MIME type, size, and the object locator.
PDS_BLOB_BACKEND=postgres
# Optional shared rate limits. No Redis connection is made in memory mode.
PDS_RATE_LIMIT_BACKEND=memory
PDS_RATE_LIMIT_REQUESTS=120
PDS_RATE_LIMIT_WINDOW_SECONDS=60
# PDS_REDIS_URL=rediss://user:password@redis.example.com:6379/0
# PDS_REDIS_PREFIX=clojure-pds
# PDS_S3_BUCKET=pds-blobs
# PDS_S3_REGION=us-east-1
# PDS_S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
# PDS_S3_FORCE_PATH_STYLE=false
# PDS_S3_PREFIX=blobs
# Omit credentials to use the AWS default credential chain.
# PDS_S3_ACCESS_KEY_ID=
# PDS_S3_SECRET_ACCESS_KEY=
# PDS_S3_SESSION_TOKEN=
# Leave ALL three UNSET to disable email; do not export blank values.
# PDS_EMAIL_WORKER_URL=https://your-worker.example.workers.dev/
# PDS_EMAIL_WORKER_TOKEN=
# PDS_EMAIL_FROM=noreply@example.com

# Optional separate record-write request budget (create/put/delete/applyWrites).
# Unset: shares the general rate limit above. Set false to disable write limits
# entirely, including the general IP budget for these four POST endpoints.
# PDS_RECORD_WRITE_RATE_LIMIT_ENABLED=true
# PDS_RECORD_WRITE_RATE_LIMIT_REQUESTS=120
# PDS_RECORD_WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# Full getRepo CAR export limit: 1 MiB–16 GiB, default 256 MiB.
# Two slots shared by full/partial exports; allow max(this limit, 64 MiB) each.
# PDS_REPO_EXPORT_MAX_BYTES=268435456
